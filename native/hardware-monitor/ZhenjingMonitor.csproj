<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Hud/china-holidays.json" LogicalName="EndfieldChargePlus.china-holidays.json" />
    <EmbeddedResource Include="Hud/Locales/*.json" LogicalName="Zhenjing.Hud.Locale.%(Filename)" />
    <EmbeddedResource Include="Hud/Collector/ECPFrames-x64.exe" LogicalName="EndfieldChargePlus.PresentMon" />
    <EmbeddedResource Include="../../src-tauri/resources/licenses/ECPFrames-MIT.txt" LogicalName="EndfieldChargePlus.PresentMon.License" />
  </ItemGroup>
</Project>
