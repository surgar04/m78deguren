{
  "name": "zhenjing",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "preinstall": "node scripts/check-environment.ts",
    "dev": "node scripts/check-environment.ts && vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm typecheck && node scripts/build-hardware-web.ts && vite build",
    "build:empty": "pnpm typecheck && vite build --outDir .cache/build-empty",
    "preview": "vite preview",
    "tauri": "node scripts/check-environment.ts && tauri",
    "desktop:dev": "pnpm tauri dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "desktop:bundle": "pnpm desktop:build",
    "desktop:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -Publish",
    "desktop:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-packages.ps1",
    "release:publish": "node scripts/publish-release.ts",
    "release:verify": "node scripts/verify-public-release.ts",
    "test:onboarding:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-onboarding-native.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-migration-copy.ps1",
    "test:onboarding:desktop": "node scripts/smoke-onboarding.ts",
    "test:launchers:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-launchers-native.ps1",
    "desktop:launchers:dev": "pnpm tauri dev --config src-tauri/tauri.test.conf.json --no-watch",
    "test:launchers:desktop": "node scripts/smoke-launchers.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:hud:native && pnpm test:onboarding:native && pnpm test:launchers:native && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test && pnpm installer:check && pnpm test:distribution:native",
    "installer:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-installer.ps1",
    "env:check": "node scripts/doctor.ts",
    "test:desktop": "node scripts/smoke-home.ts",
    "test:home:desktop": "node scripts/smoke-home.ts",
    "test:home:native": "node scripts/verify-home-native.ts",
    "test:tools:desktop": "node scripts/smoke-tools.ts",
    "test:optimization:desktop": "node scripts/smoke-optimization.ts",
    "test:hardware:desktop": "node scripts/smoke-hardware.ts",
    "test:hardware:report": "node scripts/verify-hardware-report.ts",
    "test:hud:desktop": "node scripts/smoke-hud.ts",
    "test:hud:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-hud-native.ps1",
    "test:hud:engine": "node scripts/verify-hud-engine.ts",
    "test:hud:game": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-hud-game.ps1",
    "test:hud:media": "node scripts/verify-hud-media.ts",
    "test:hud:download": "node scripts/verify-hud-download.ts",
    "test:hud:performance": "node scripts/measure-hud.ts",
    "test:steam:desktop": "node scripts/smoke-steam.ts",
    "test:installer": "node scripts/verify-installer.ts",
    "test:distribution:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-distribution-native.ps1",
    "test:distribution:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-distribution-startup.ps1",
    "desktop:test:dev": "pnpm tauri dev --config src-tauri/tauri.test.conf.json --no-watch",
    "desktop:first-run:dev": "pnpm tauri dev --config src-tauri/tauri.test.conf.json --no-watch"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "6.0.0",
    "@tanstack/react-query": "5.104.5",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-store": "2.5.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
