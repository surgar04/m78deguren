<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <RootNamespace>PluginWorld</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <UseAppHost>false</UseAppHost>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!-- 创建为独立工程后 SDK 位于 sdk/ 下，避免默认通配与下面显式链接重复编译。 -->
    <Compile Remove="sdk/**/*.cs" />
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <PackageReference Include="runtime.win-x64.Microsoft.DotNet.ILCompiler.LLVM" Version="10.0.0-rc.1.26306.1" PrivateAssets="All" />
    <Wit Include="../../wit/plugin.wit" World="plugin" />
    <Compile Include="../../sdk/csharp/PluginClient.cs" Link="PluginClient.cs" />
  </ItemGroup>
</Project>

