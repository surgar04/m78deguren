{
  "formatVersion": 1,
  "id": "org.zhenjing.example-typescript",
  "name": "typescript 示例插件",
  "description": "展示独立沙箱、私有存储和声明式界面。",
  "version": "1.0.0",
  "publisher": "臻境 SDK 示例",
  "language": "typescript",
  "runtime": "wasm-component",
  "api": "^1.0.0",
  "host": ">=0.10.3, <1.0.0",
  "entry": "component.wasm",
  "license": "AGPL-3.0-only",
  "dataVersion": 1,
  "limits": {
    "memoryMb": 256,
    "fuel": 500000000,
    "timeoutMs": 10000,
